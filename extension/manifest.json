{
  "manifest_version": 3,
  "name": "Clef Browser Bridge",
  "description": "Lets the local clef-browser CLI drive a dedicated tab in this Chrome profile.",
  "version": "0.1.0",
  "key": "",
  "permissions": [
    "debugger",
    "nativeMessaging",
    "tabs",
    "tabGroups",
    "alarms",
    "storage"
  ],
  "background": { "service_worker": "background.js" }
}
