{
  "name": "agent-quick-browse",
  "version": "0.5.0",
  "description": "Fast, cheap browser actions for agents: a decision model (Jev or Clef) drives your real, logged-in Chrome. CLI + MCP server.",
  "keywords": [
    "browser-automation",
    "mcp",
    "agent",
    "chrome",
    "jev",
    "clef",
    "claude-code"
  ],
  "license": "MIT",
  "author": "Zach Sents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zachsents/agent-quick-browse.git"
  },
  "homepage": "https://github.com/zachsents/agent-quick-browse#readme",
  "type": "module",
  "bin": {
    "agent-quick-browse": "src/index.ts",
    "aqb": "src/index.ts"
  },
  "files": [
    "src",
    "extension",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.3"
  },
  "os": [
    "darwin"
  ],
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "bun src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "command -v tsgo >/dev/null && tsgo --noEmit || tsc --noEmit",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix --fix-suggestions",
    "format": "prettier . --write",
    "fix": "bun run lint:fix && bun run format",
    "check": "bun run typecheck && bun run fix",
    "ci": "bun run typecheck && bun run lint && prettier . --check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "remeda": "^2.51.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "3.4.2",
    "prettier-plugin-jsdoc": "^1.8.0",
    "typescript": "^5.9.3"
  }
}
